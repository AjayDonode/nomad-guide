
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user profile in the system, storing roles and preferences.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The name displayed in the UI."
        },
        "photoURL": {
          "type": "string",
          "description": "URL to the user's avatar image."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Flag indicating if the user has administrative privileges."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email"]
    },
    "FavoriteTrip": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FavoriteTrip",
      "type": "object",
      "description": "A trip saved by a user to their favorites list.",
      "properties": {
        "tripId": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tripId"]
    },
    "Trip": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Trip",
      "type": "object",
      "description": "Represents a planned tour itinerary. Accessible by all authenticated users, but editable only by the owner.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "startLatitude": { "type": "number" },
        "startLongitude": { "type": "number" },
        "endLatitude": { "type": "number" },
        "endLongitude": { "type": "number" },
        "adminId": { "type": "string", "description": "The UID of the admin who created this trip." },
        "isAdminTrip": { "type": "boolean", "description": "Flag indicating if this trip is restricted to admin visibility." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "adminId"]
    },
    "TripPoi": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TripPoi",
      "type": "object",
      "description": "A stop within a trip.",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "poiId": { "type": "string" },
        "orderIndex": { "type": "number" },
        "adminId": { "type": "string" },
        "name": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "images": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of base64 encoded images or URLs."
        }
      },
      "required": ["id", "tripId", "adminId", "orderIndex"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records."
    },
    "/users/{userId}/favorites/{tripId}": {
      "schema": "FavoriteTrip",
      "description": "User's saved trips."
    },
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Top-level collection for Trip entities."
    },
    "/trips/{tripId}/trip_pois/{tripPoiId}": {
      "schema": "TripPoi",
      "description": "Stops within a trip."
    }
  }
}
