
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user profile in the system, storing roles and preferences.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The name displayed in the UI."
        },
        "photoURL": {
          "type": "string",
          "description": "URL to the user's avatar image."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Flag indicating if the user has administrative privileges."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email"]
    },
    "Trip": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Trip",
      "type": "object",
      "description": "Represents a planned tour itinerary designed by an administrator.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "startLatitude": { "type": "number" },
        "startLongitude": { "type": "number" },
        "adminId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "adminId"]
    },
    "TripPoi": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TripPoi",
      "type": "object",
      "description": "A stop within a trip.",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "poiId": { "type": "string" },
        "orderIndex": { "type": "number" },
        "adminId": { "type": "string" },
        "name": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["id", "tripId", "adminId", "orderIndex"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profile records."
        }
      },
      {
        "path": "/trips/{tripId}",
        "definition": {
          "entityName": "Trip",
          "schema": { "$ref": "#/backend/entities/Trip" },
          "description": "Top-level collection for Trip entities."
        }
      },
      {
        "path": "/trips/{tripId}/trip_pois/{tripPoiId}",
        "definition": {
          "entityName": "TripPoi",
          "schema": { "$ref": "#/backend/entities/TripPoi" },
          "description": "Stops within a trip."
        }
      }
    ]
  }
}
