rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // isAdmin: true if user has isAdmin:true flag OR role:"admin" in their profile
    function isAdmin() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && (u.isAdmin == true || u.role == 'admin');
    }

    // isStaff: admin OR designer role (can create/edit tours but not delete)
    function isStaff() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && (u.isAdmin == true || u.role == 'admin' || u.role == 'designer');
    }

    match /users/{userId} {
      // Users can read/write their own doc; admins can read all and update roles
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      match /favorites/{tripId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Trip feedback: any signed-in user can submit feedback
    match /trip_feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isStaff();          // admin + designer can create trips
      allow delete: if isAdmin();          // only admin can delete
      allow update: if isStaff() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['runCount']));

      match /trip_pois/{poiId} {
        allow read: if isSignedIn();
        allow write: if isStaff();

        // Nearby Sights — images stored in Firebase Storage, URLs here
        // Write restricted to staff; all signed-in users can read for gallery
        match /sights/{sightId} {
          allow read: if isSignedIn();
          allow write: if isStaff();
        }
      }
    }

    // Trip-specific traveler chat — all signed-in users can read and post
    match /chats/{tripId}/messages/{messageId} {
      allow read: if isSignedIn();

      // Create: must own the message, max 140 chars, required fields
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 140
        && request.resource.data.authorName is string;

      // Messages are immutable — no edit or delete
      allow update, delete: if false;
    }

    // System health docs (written only by Cloud Functions / Admin SDK)
    match /_system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Tour Blogs - read by anyone, writable only by admins
    match /tourBlogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI Tour Workflow documents — created and managed by admin agents
    // Cloud Functions write progress updates; admin UI reads in real time
    match /tour_workflows/{workflowId} {
      allow read, write: if isStaff();
    }
  }
}