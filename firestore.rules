
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /trips/{tripId} {
      // For 'list' operations (queries), the rule must be query-agnostic or match the filter.
      // We allow read if the user is signed in. The query filter in the code (where adminId == uid)
      // combined with the resource check ensures security.
      allow read: if isSignedIn() && (
        resource.data.adminId == request.auth.uid || 
        resource.data.get('isAdminTrip', false) == false
      );
      
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.adminId == request.auth.uid;

      match /trip_pois/{poiId} {
        // Inherit permissions from parent trip or allow if the POI itself is owned
        allow read: if isSignedIn() && (
          resource.data.adminId == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.adminId == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.get('isAdminTrip', false) == false
        );
        
        allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.adminId == request.auth.uid;
      }
    }
  }
}
