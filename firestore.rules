
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      // Consolidated read rule for better QAP matching.
      // Allows access if user is the owner OR if the trip is public (not admin-only).
      allow read: if isSignedIn() && (
        resource.data.get('adminId', '') == request.auth.uid ||
        resource.data.get('isAdminTrip', false) == false
      );
      
      // Allow creation only if the user assigns themselves as the admin
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      
      // Allow updates and deletion only for the owner
      allow update, delete: if isSignedIn() && resource.data.adminId == request.auth.uid;

      match /trip_pois/{poiId} {
        // Helper function to safely access the parent trip's visibility settings
        function getParentTrip() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }

        // POIs inherit the specific visibility of their parent trip
        allow read: if isSignedIn() && (
          getParentTrip().adminId == request.auth.uid ||
          getParentTrip().get('isAdminTrip', false) == false
        );
        
        // Only the owner of the parent trip can modify stops
        allow write: if isSignedIn() && getParentTrip().adminId == request.auth.uid;
      }
    }
  }
}
