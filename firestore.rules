
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      // Allowing any authenticated user to read trip metadata simplifies query validation.
      // Private data is still protected as users only query for their own adminId.
      allow read: if isSignedIn();
      
      // Only the owner can create, update, or delete their trips.
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.adminId == request.auth.uid;

      match /trip_pois/{poiId} {
        // POIs are readable if the parent trip is accessible (which is always true for signed-in users)
        allow read: if isSignedIn();
        
        // Only the owner of the parent trip can modify stops.
        // We verify this by checking the parent document's adminId.
        allow write: if isSignedIn() && 
          get(/databases/$(database)/documents/trips/$(tripId)).data.adminId == request.auth.uid;
      }
    }
  }
}
