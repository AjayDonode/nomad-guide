
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      // Split rules for better query-to-rule matching
      
      // 1. Allow owners to read (list/get) their own trips
      allow read: if isSignedIn() && resource.data.adminId == request.auth.uid;
      
      // 2. Allow everyone signed in to see public (non-admin-only) trips
      allow read: if isSignedIn() && resource.data.get('isAdminTrip', false) == false;
      
      // 3. Allow creation if the user is assigning themselves as the admin
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      
      // 4. Allow updates and deletion only for the owner
      allow update, delete: if isSignedIn() && resource.data.adminId == request.auth.uid;

      match /trip_pois/{poiId} {
        // Helper function to access the parent trip's data
        function getParentTrip() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }

        // POIs inherit the visibility of their parent trip
        allow read: if isSignedIn() && (
          getParentTrip().adminId == request.auth.uid ||
          getParentTrip().get('isAdminTrip', false) == false
        );
        
        // Only the owner of the parent trip can modify POIs
        allow write: if isSignedIn() && getParentTrip().adminId == request.auth.uid;
      }
    }
  }
}
