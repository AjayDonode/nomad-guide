
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /trips/{tripId} {
      allow read: if isSignedIn() && (resource.data.adminId == request.auth.uid || !resource.data.isAdminTrip);
      allow write: if isSignedIn() && request.resource.data.adminId == request.auth.uid;

      match /trip_pois/{poiId} {
        allow read, write: if isSignedIn() && (resource.data.adminId == request.auth.uid || request.resource.data.adminId == request.auth.uid);
      }
    }
  }
}
