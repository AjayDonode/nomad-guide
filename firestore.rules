rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /favorites/{tripId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /trips/{tripId} {
      allow read, write: if true;

      match /trip_pois/{poiId} {
        allow read, write: if true;
      }
    }

    // Global traveler chat — all signed-in users can read and post
    match /globalChat/{messageId} {
      allow read: if isSignedIn();

      // Create: must own the message, max 140 chars, required fields
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 140
        && request.resource.data.authorName is string;

      // Messages are immutable — no edit or delete
      allow update, delete: if false;
    }

    // System health docs (written only by Cloud Functions / Admin SDK)
    match /_system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}