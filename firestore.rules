
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      // Use a broad read permission for signed-in users to facilitate collection queries.
      // Data privacy is maintained by the query filters in the application code.
      allow read: if isSignedIn();
      
      // Strict write permissions: only the creator can modify their trip itineraries.
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.adminId == request.auth.uid;

      match /trip_pois/{poiId} {
        // POIs follow the same read access as their parent trip.
        allow read: if isSignedIn();
        
        // Only the trip owner can manage the points of interest within it.
        allow write: if isSignedIn() && 
          get(/databases/$(database)/documents/trips/$(tripId)).data.adminId == request.auth.uid;
      }
    }
  }
}
